# Copiá este archivo como .env.local y completá los valores.
# En Netlify, cargá las mismas variables en Site configuration → Environment variables.

# --- Frontend (públicas: quedan dentro del bundle del navegador) ---
# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Servidor (secretas: solo las lee la Netlify Function, nunca el navegador) ---
# Google AI Studio → API keys
GEMINI_API_KEY=
# Opcional: modelo de Gemini (por defecto gemini-2.5-flash)
# GEMINI_MODEL=

# Nunca pongas acá la secret key de Supabase (sb_secret_...): el frontend no la necesita.
